<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
      Índice para as consultas de agenda (sobreposição e agenda pública), que filtram por
      prestador + data do evento. Medir com EXPLAIN antes/depois num banco com volume.
    -->
    <changeSet id="0.13.0-idx-pedido-prestador-data" author="GF">
        <createIndex tableName="tb_pedidos" indexName="idx_pedido_prestador_data">
            <column name="prestador_id"/>
            <column name="data_do_evento"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
