# Copie para .env e preencha. O .env é ignorado pelo Git: segredo não vai para o repositório,
# nem como valor padrão nos application-*.properties.

# Banco (obrigatório)
DB_URL=jdbc:postgresql://localhost:5432/festconnectdb
DB_USERNAME=
DB_PASSWORD=
DB_NAME=festconnectdb

# Segredo que assina os JWT (obrigatório). Gere um aleatório, por exemplo: openssl rand -base64 48
SECRET_KEY_TOKEN=

# Admin inicial (opcional). Sem estas variáveis, nenhum admin é criado.
# A senha precisa ter pelo menos 12 caracteres, senão a aplicação não sobe.
ADMIN_EMAIL=
ADMIN_SENHA=

# E-mail em dev via Mailtrap (opcional). Sem elas, a aplicação sobe e só o envio falha.
MAIL_TRAP_USERNAME=
MAIL_TRAP_SENHA=

# Storage de fotos e vídeos em dev: SeaweedFS (S3 compatível) no docker-compose.
# As mesmas chaves servem para o container e para a aplicação. Gere valores aleatórios.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Login com Google (obrigatório para subir)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
